# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-string
DEBUG=True

# Database (PostGIS)
DATABASE_URL=postgis://postgres:postgres@postgres:5432/realestate

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Nominatim (internal Docker hostname)
NOMINATIM_URL=http://nominatim:8080

# Email (Mailpit)
EMAIL_HOST=mailpit
EMAIL_PORT=1025

# Claude API (for listing classification)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional model overrides (defaults shown)
# CLAUDE_EVAL_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5

# Saved-search digest recipient (empty = digest emails are skipped)
NOTIFY_EMAIL=

# TypeSafe API key
TYPESAFE_API_KEY=

